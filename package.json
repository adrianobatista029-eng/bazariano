{
  "name": "marketplace-entregadores",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:gen-types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > packages/supabase/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.114.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  }
}
